# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Caches & OS files
.DS_Store
Thumbs.db
.pytest_cache/
.coverage
htmlcov/
.idea/
.vscode/
*.tmp
*.log

# Virtual Environments
venv/
.venv/
env/
.env

# Local Datasets, Embeddings & Tokenized Data
data/embeddings/*.bin
data/embeddings/*.pkl
data/data_combined/
data/tokenized/
data/finetune_data.json
data/processed/*.csv
data/raw/*.csv

# Allow Directory Keepers (.gitkeep)
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/tickets/.gitkeep
!models/generator/lora/.gitkeep

# Model Weights & Checkpoints
models/*
!models/generator/
!models/generator/lora/
!models/generator/lora/.gitkeep